# Salin file ini jadi ".env" (di folder yang sama), lalu isi nilai aslinya
# di ".env". File ".env" TIDAK di-commit ke git -- ".env.example" ini yang
# di-commit, cuma sebagai template/dokumentasi key apa saja yang dibutuhkan.

# SMTP buat kirim email OTP & reset password (gratis pakai Gmail + App Password,
# lihat cara bikin App Password di application/config/otp.php)
OTP_MAIL_SMTP_HOST=smtp.gmail.com
OTP_MAIL_SMTP_PORT=587
OTP_MAIL_SMTP_USER=
OTP_MAIL_SMTP_PASS=
OTP_MAIL_SMTP_CRYPTO=tls
OTP_MAIL_FROM_EMAIL=
OTP_MAIL_FROM_NAME=Sistem Antrian Donor Darah

# WhatsApp Gateway Fonnte (opsional, berbayar) -- https://fonnte.com
OTP_FONNTE_TOKEN=

# SMS Twilio (opsional, berbayar) -- https://www.twilio.com
OTP_TWILIO_ACCOUNT_SID=
OTP_TWILIO_AUTH_TOKEN=
OTP_TWILIO_FROM_NUMBER=
