RewriteEngine On

RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Papan antrian digital (FR-5.4): satu halaman statis tunggal yang tidak
# pernah bertingkat (selalu persis /papan-antrian.html), jadi aman
# disajikan langsung sebagai file tanpa lewat CodeIgniter.
RewriteRule ^papan-antrian\.html$ frontend/papan-antrian/index.html [L]

# Semua request lain yang bukan file/direktori asli (aset CSS/JS tetap
# disajikan langsung sebagai file statis oleh Apache, tidak lewat baris ini)
# diteruskan ke CodeIgniter. routes.php yang menentukan controller mana yang
# menangani: REST API lewat prefix /api/*, panel internal lewat /admin*,
# selebihnya halaman pendonor -- lihat komentar di routes.php. CI3
# ($config['uri_protocol'] = 'REQUEST_URI') membaca URL asli dari server,
# jadi tidak masalah target rewrite di bawah ini tidak membawa path apa pun.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
